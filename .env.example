APP_NAME="HAVOC AGENCY"
# Produktion: APP_ENV=production und APP_DEBUG=false
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Europe/Berlin

APP_LOCALE=de
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=de_DE

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Lokal: SQLite (database/database.sqlite).
# Produktion (IONOS, nur vom Webspace aus erreichbar):
# DB_CONNECTION=mariadb
# DB_HOST=db5021642839.hosting-data.io
# DB_PORT=3306
# DB_DATABASE=havoc_agency
# DB_USERNAME=
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=havoc_session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

# Produktion: MAIL_MAILER=sendmail (wie bisher PHP mail()) oder SMTP-Zugang von IONOS
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="info@havoc-agency.com"
MAIL_FROM_NAME="${APP_NAME}"

# Kontaktanfragen zusätzlich an diese Adresse mailen (leer = nur in der Datenbank speichern)
CONTACT_MAIL_TO=

# Maximale Bildgröße in KB (passend zu public/.user.ini)
UPLOAD_MAX_KILOBYTES=512000

# Band-Manager: Kontakt im Pressekit (leer lassen = Standardwerte aus config/band-manager.php)
# BAND_MANAGER_CONTACT_NAME="HAVOC AGENCY"
# BAND_MANAGER_CONTACT_PERSON=
# BAND_MANAGER_CONTACT_EMAIL=
# BAND_MANAGER_CONTACT_PHONE=
# BAND_MANAGER_CONTACT_WEBSITE=
